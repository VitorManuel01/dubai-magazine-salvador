# Modelo para produção. Este arquivo não é carregado durante o desenvolvimento.
# Substitua DOMINIO_EXEMPLO e os caminhos antes de habilitá-lo no Nginx.

server {
    listen 80;
    listen [::]:80;
    server_name DOMINIO_EXEMPLO www.DOMINIO_EXEMPLO;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name DOMINIO_EXEMPLO www.DOMINIO_EXEMPLO;

    root /var/www/dubai-magazine;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/DOMINIO_EXEMPLO/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMINIO_EXEMPLO/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location /api/ {
        proxy_pass http://127.0.0.1:8081/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        client_max_body_size 20m;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
