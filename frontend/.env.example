# Variáveis públicas incorporadas ao build. Nunca coloque segredos VITE_*.
VITE_APP_ENV=development
VITE_API_BASE_URL=http://IP_LOCAL:8081
VITE_REQUIRE_HTTPS=false

# Pré-produção e produção usam /api na mesma origem HTTPS do frontend.
# O proxy local, Cloudflare ou Locaweb encaminha /api ao Spring Boot.
