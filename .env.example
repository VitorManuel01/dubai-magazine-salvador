DB_URL=jdbc:mysql://127.0.0.1:3306/catalogo_dubai
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha
JWT_SECRET=gere_ao_menos_32_bytes_aleatorios
AUDIT_HMAC_SECRET=gere_outro_segredo_aleatorio_independente
JWT_EXPIRATION_SECONDS=3600
SPRING_PROFILES_ACTIVE=development
PRODUCT_IMAGES_DIR=C:/dados/dubai-magazine/produtos
LOGIN_MAX_FAILED_ATTEMPTS=3
LOGIN_LOCK_DURATION=PT20M

# Opcional no desenvolvimento se o IP local mudar:
# CORS_ALLOWED_ORIGINS=http://NOVO_IP:5173,http://localhost:5173
# SERVER_ADDRESS=0.0.0.0

# Em pré-produção e produção, selecione o perfil na inicialização.
# O HTTPS é obrigatório nesses perfis e o backend usa 127.0.0.1 por padrão.
# Em produção, use duas contas diferentes no banco. DB_USERNAME/DB_PASSWORD
# continuam úteis apenas em development/preproduction.
DB_APP_USERNAME=usuario_aplicacao_sem_ddl
DB_APP_PASSWORD=senha_da_aplicacao
DB_MIGRATION_USERNAME=usuario_flyway_com_ddl
DB_MIGRATION_PASSWORD=senha_das_migrations

# Contenção de recursos. Ajuste apenas depois de medir o servidor.
DB_POOL_MAX_SIZE=10
DB_QUERY_TIMEOUT_MS=5000
PUBLIC_CATALOG_RATE_CAPACITY=60
PUBLIC_CATALOG_RATE_REFILL=1
PUBLIC_CATALOG_MAX_CONCURRENT=4
PUBLIC_IMAGE_RATE_CAPACITY=240
PUBLIC_IMAGE_RATE_REFILL=4
AUDIT_RETENTION=P180D
PRODUCT_IMAGES_CLEANUP_ENABLED=true
PRODUCT_IMAGES_CLEANUP_MINIMUM_AGE=PT24H

TEST_DB_URL=jdbc:mysql://127.0.0.1:3306/dubai_testes
TEST_DB_USERNAME=seu_usuario_de_testes
TEST_DB_PASSWORD=sua_senha_de_testes
